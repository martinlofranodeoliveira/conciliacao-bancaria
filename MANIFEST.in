include README.md LICENSE pyproject.toml MANIFEST.in requirements-build.txt .gitignore .gitattributes
recursive-include .github/workflows *.yml
recursive-include src/conciliacao_bancaria *.py *.json
recursive-include tests *.py
recursive-include scripts *.py
recursive-include tools *.py
recursive-include docs *.md *.png *.svg
prune local
prune dist
prune build
prune .venv-build
prune .openai
prune .impeccable
global-exclude *.py[cod] __pycache__ .env .env.*
